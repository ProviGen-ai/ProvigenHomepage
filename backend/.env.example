# --- Local development ---
# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4

# TxGemma (Modal-hosted vLLM endpoint — only needed for local dev)
TXGEMMA_BASE_URL=https://YOUR_WORKSPACE--txgemma-vllm-serve.modal.run/v1
TXGEMMA_MODEL=google/txgemma-27b-chat

# Biomni
BIOMNI_ENABLED=false
BIOMNI_SERVICE_URL=http://localhost:8001

# BioReason-Pro (optional, disabled by default)
BIOREASON_ENABLED=false
BIOREASON_SERVICE_URL=http://localhost:8002

# Workshop auth
WORKSHOP_SECRET=dev-secret
WORKSHOP_ADMIN_PASSWORD=admin

# --- Modal deployment ---
# Create a Modal secret with these values:
#   modal secret create workshop-secrets \
#       OPENAI_API_KEY=sk-... \
#       WORKSHOP_SECRET=your-production-secret \
#       WORKSHOP_ADMIN_PASSWORD=your-password \
#       BIOMNI_ENABLED=false \
#       BIOREASON_ENABLED=false
