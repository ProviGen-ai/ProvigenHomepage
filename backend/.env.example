# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4

# TxGemma (Modal-hosted vLLM endpoint)
TXGEMMA_BASE_URL=https://YOUR_WORKSPACE--txgemma-vllm-serve.modal.run/v1
TXGEMMA_MODEL=google/txgemma-27b-chat

# Biomni
BIOMNI_ENABLED=true
BIOMNI_SERVICE_URL=http://localhost:8001

# BioReason-Pro (optional, disabled by default)
BIOREASON_ENABLED=false
BIOREASON_SERVICE_URL=http://localhost:8002
