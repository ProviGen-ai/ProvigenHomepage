{
  "openapi": "3.1.0",
  "info": {
    "title": "SDM-1 API",
    "version": "1.0.1",
    "description": "Proposes the next settings to evaluate, from a parameter space and the values observed so far.\n\nThe service is stateless and deterministic: every call carries the whole history, and an unchanged request returns the same proposals.\n\n**The loop.** A call carries the parameter space, every result obtained so far as `history`, and the number of\nsettings wanted as `batch`. After evaluation, the results are appended to `history` for the next call. A request\nwithout new results returns the same batch.\n\n**Failed runs** are history rows with `\"value\": null`: the setting counts as tried and infeasible and is excluded\nfrom later proposals. Every history row carries `value`, a number or null.\n\n**Retries.** 429 and 503 carry `Retry-After`; the same call succeeds after that interval. Any other 4xx requires a\ncorrected request or a new token. A client timeout of at least 60 s covers the longest calls.\n\n**Tokens.** Tokens are issued at [https://provigen.ai/sdm1](https://provigen.ai/sdm1). A trial token serves 20 calls at once; the\nlink sent by email raises the allowance to 50 calls a day and 500 in total. Each token is limited\nto 10 requests a minute.\n\nThe whole contract as one Markdown file, for agents: [https://provigen.ai/sdm1/api.md](https://provigen.ai/sdm1/api.md). The index for agents is\n[https://api.provigen.ai/llms.txt](https://api.provigen.ai/llms.txt).",
    "contact": {
      "name": "ProviGen",
      "url": "https://provigen.ai"
    }
  },
  "servers": [
    {
      "url": "https://api.provigen.ai"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ],
  "tags": [
    {
      "name": "optimisation",
      "description": "Proposal of the next settings to evaluate."
    },
    {
      "name": "account",
      "description": "Consumption and remaining allowance of a token."
    },
    {
      "name": "service",
      "description": "Service state."
    },
    {
      "name": "discovery",
      "description": "Routes served without a token."
    }
  ],
  "paths": {
    "/v1/propose": {
      "post": {
        "tags": [
          "optimisation"
        ],
        "summary": "The next settings to evaluate",
        "description": "Returns `batch` settings to evaluate next, from the parameter space and every result obtained so far. The service responds within approximately 54 seconds.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProposeRequest"
              },
              "examples": {
                "first_call": {
                  "summary": "One outcome, a failed run in the history",
                  "value": {
                    "space": [
                      {
                        "name": "temperature",
                        "type": "continuous",
                        "low": 20,
                        "high": 80
                      },
                      {
                        "name": "catalyst",
                        "type": "categorical",
                        "choices": [
                          "A",
                          "B",
                          "C"
                        ]
                      }
                    ],
                    "history": [
                      {
                        "params": {
                          "temperature": 35,
                          "catalyst": "A"
                        },
                        "value": 0.42
                      },
                      {
                        "params": {
                          "temperature": 70,
                          "catalyst": "B"
                        },
                        "value": null
                      }
                    ],
                    "batch": 2,
                    "goal": "maximize"
                  }
                },
                "several_objectives": {
                  "summary": "Two outcomes, weighted",
                  "value": {
                    "space": [
                      {
                        "name": "temperature",
                        "type": "continuous",
                        "low": 20,
                        "high": 80
                      },
                      {
                        "name": "time_min",
                        "type": "integer",
                        "low": 5,
                        "high": 120
                      }
                    ],
                    "objectives": [
                      {
                        "name": "yield",
                        "goal": "maximize"
                      },
                      {
                        "name": "cost",
                        "goal": "minimize"
                      }
                    ],
                    "history": [
                      {
                        "params": {
                          "temperature": 35,
                          "time_min": 30
                        },
                        "value": 0.4,
                        "values": {
                          "yield": 0.62,
                          "cost": 0.22
                        }
                      },
                      {
                        "params": {
                          "temperature": 70,
                          "time_min": 90
                        },
                        "value": null,
                        "values": {
                          "yield": null,
                          "cost": null
                        }
                      }
                    ],
                    "batch": 2,
                    "goal": "maximize"
                  }
                },
                "pareto": {
                  "summary": "Two outcomes, every trade-off",
                  "value": {
                    "space": [
                      {
                        "name": "temperature",
                        "type": "continuous",
                        "low": 20,
                        "high": 80
                      },
                      {
                        "name": "pressure_bar",
                        "type": "continuous",
                        "low": 1,
                        "high": 10
                      }
                    ],
                    "objectives": [
                      {
                        "name": "yield",
                        "goal": "maximize",
                        "reference": 0
                      },
                      {
                        "name": "cost",
                        "goal": "minimize",
                        "reference": 10
                      }
                    ],
                    "mode": "pareto",
                    "history": [
                      {
                        "params": {
                          "temperature": 30,
                          "pressure_bar": 8
                        },
                        "value": 1,
                        "values": {
                          "yield": 0.5,
                          "cost": 4
                        }
                      },
                      {
                        "params": {
                          "temperature": 70,
                          "pressure_bar": 2
                        },
                        "value": 1,
                        "values": {
                          "yield": 0.9,
                          "cost": 7.5
                        }
                      }
                    ],
                    "batch": 2,
                    "goal": "maximize"
                  }
                },
                "design": {
                  "summary": "A first design, before any result",
                  "value": {
                    "space": [
                      {
                        "name": "ph",
                        "type": "continuous",
                        "low": 5.5,
                        "high": 8.5
                      },
                      {
                        "name": "inducer_mM",
                        "type": "continuous",
                        "low": 0.01,
                        "high": 1,
                        "log": true
                      }
                    ],
                    "history": [],
                    "batch": 8,
                    "goal": "maximize",
                    "method": "doe-lhs"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The proposals.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProposeAnswer"
                }
              }
            }
          },
          "400": {
            "description": "The request is outside the contract, or its predicted computation exceeds the time limit; the message names the field or the limit. The same body is refused again.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "invalid_request": {
                    "value": {
                      "error": "invalid_request",
                      "message": "space must be a non-empty list of parameters",
                      "docs": "https://provigen.ai/sdm1/api.md"
                    }
                  },
                  "missing_value": {
                    "value": {
                      "error": "invalid_request",
                      "message": "history[0]: value is required: a number, or null for a failed run",
                      "docs": "https://provigen.ai/sdm1/api.md"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "The request carries no Authorization header.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "unauthorized": {
                    "value": {
                      "error": "unauthorized",
                      "message": "Authorization header required. A token is issued at https://provigen.ai/sdm1",
                      "docs": "https://provigen.ai/sdm1/api.md"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "The token is unknown, replaced or revoked. A new token is issued by the Get access form at https://provigen.ai/sdm1.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "forbidden": {
                    "value": {
                      "error": "forbidden",
                      "message": "This token is unknown, replaced or revoked. A new token is issued at https://provigen.ai/sdm1",
                      "docs": "https://provigen.ai/sdm1/api.md"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Either the per-minute limit is reached, and the same call succeeds after the Retry-After interval, or an allowance is exhausted, shown by the absence of retry_after_s.",
            "headers": {
              "Retry-After": {
                "description": "The interval in seconds after which the same call succeeds.",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "rate_limited": {
                    "value": {
                      "error": "rate_limited",
                      "message": "Too many requests with this token; at most 10 requests a minute.",
                      "retry_after_s": 60,
                      "docs": "https://provigen.ai/sdm1/api.md"
                    }
                  },
                  "trial_used_up": {
                    "value": {
                      "error": "quota_exceeded",
                      "message": "The 20 trial calls for this address are used. Opening the confirmation link raises the allowance.",
                      "docs": "https://provigen.ai/sdm1/api.md"
                    }
                  },
                  "total_used_up": {
                    "value": {
                      "error": "quota_exceeded",
                      "message": "The 500 calls in total for this token are used. Contact ProviGen for more.",
                      "docs": "https://provigen.ai/sdm1/api.md"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "The service is under load or paused. The same call succeeds after the Retry-After interval.",
            "headers": {
              "Retry-After": {
                "description": "The interval in seconds after which the same call succeeds.",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "high_demand": {
                    "value": {
                      "error": "high_demand",
                      "message": "The model is busy right now. Please try again shortly.",
                      "retry_after_s": 30,
                      "docs": "https://provigen.ai/sdm1/api.md"
                    }
                  },
                  "paused": {
                    "value": {
                      "error": "paused",
                      "message": "Paused for maintenance.",
                      "retry_after_s": 60,
                      "docs": "https://provigen.ai/sdm1/api.md"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/usage": {
      "get": {
        "tags": [
          "account"
        ],
        "summary": "Token consumption and remaining allowance",
        "description": "Counts toward the per-minute limit only.",
        "responses": {
          "200": {
            "description": "The allowance of a trial or a full token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Usage"
                },
                "examples": {
                  "usage_trial": {
                    "value": {
                      "tier": "trial",
                      "trial": {
                        "used": 7,
                        "limit": 20,
                        "remaining": 13
                      },
                      "trial_pool_open_today": true,
                      "per_minute": 10
                    }
                  },
                  "usage_full": {
                    "value": {
                      "tier": "full",
                      "daily": {
                        "used": 12,
                        "limit": 50,
                        "remaining": 38,
                        "resets_at": "2026-11-19T00:00:00Z"
                      },
                      "total": {
                        "used": 120,
                        "limit": 500,
                        "remaining": 380
                      },
                      "per_minute": 10
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "The request carries no Authorization header.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "unauthorized": {
                    "value": {
                      "error": "unauthorized",
                      "message": "Authorization header required. A token is issued at https://provigen.ai/sdm1",
                      "docs": "https://provigen.ai/sdm1/api.md"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "The token is unknown, replaced or revoked. A new token is issued by the Get access form at https://provigen.ai/sdm1.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "forbidden": {
                    "value": {
                      "error": "forbidden",
                      "message": "This token is unknown, replaced or revoked. A new token is issued at https://provigen.ai/sdm1",
                      "docs": "https://provigen.ai/sdm1/api.md"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "The per-minute limit is reached; the same call succeeds after the Retry-After interval.",
            "headers": {
              "Retry-After": {
                "description": "The interval in seconds after which the same call succeeds.",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "rate_limited": {
                    "value": {
                      "error": "rate_limited",
                      "message": "Too many requests with this token; at most 10 requests a minute.",
                      "retry_after_s": 60,
                      "docs": "https://provigen.ai/sdm1/api.md"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/status": {
      "get": {
        "tags": [
          "service"
        ],
        "summary": "Service state: available, under load, or paused",
        "description": "Each call counts toward the per-minute limit.",
        "responses": {
          "200": {
            "description": "The state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "401": {
            "description": "The request carries no Authorization header.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "unauthorized": {
                    "value": {
                      "error": "unauthorized",
                      "message": "Authorization header required. A token is issued at https://provigen.ai/sdm1",
                      "docs": "https://provigen.ai/sdm1/api.md"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "The token is unknown, replaced or revoked. A new token is issued by the Get access form at https://provigen.ai/sdm1.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "forbidden": {
                    "value": {
                      "error": "forbidden",
                      "message": "This token is unknown, replaced or revoked. A new token is issued at https://provigen.ai/sdm1",
                      "docs": "https://provigen.ai/sdm1/api.md"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "security": [],
        "tags": [
          "discovery"
        ],
        "summary": "A JSON index of the API",
        "responses": {
          "200": {
            "description": "A JSON index of the API",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/llms.txt": {
      "get": {
        "security": [],
        "tags": [
          "discovery"
        ],
        "summary": "The index for agents, with a working first call",
        "responses": {
          "200": {
            "description": "The index for agents, with a working first call",
            "content": {
              "text/plain": {}
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "security": [],
        "tags": [
          "discovery"
        ],
        "summary": "This document",
        "responses": {
          "200": {
            "description": "This document",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "A personal token of the form sdm1_..., issued at https://provigen.ai/sdm1 and held in an environment variable."
      }
    },
    "schemas": {
      "ProposeRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "space",
          "history",
          "batch",
          "goal"
        ],
        "description": "Unknown fields anywhere in the body are refused with 400.",
        "properties": {
          "space": {
            "type": "array",
            "minItems": 1,
            "maxItems": 24,
            "items": {
              "$ref": "#/components/schemas/Parameter"
            }
          },
          "history": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "$ref": "#/components/schemas/HistoryRow"
            },
            "description": "Every run so far, failed runs included. May be empty."
          },
          "batch": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32,
            "description": "The number of settings to propose: 1 to 8, or to 32 for method 'doe-lhs'."
          },
          "goal": {
            "enum": [
              "maximize",
              "minimize"
            ],
            "description": "Required, also alongside objectives (where it is ignored)."
          },
          "objectives": {
            "type": "array",
            "minItems": 1,
            "maxItems": 24,
            "items": {
              "$ref": "#/components/schemas/Objective"
            },
            "description": "Several measured outcomes. Each history row then carries `values`, and still carries `value`."
          },
          "method": {
            "enum": [
              "sdm-1",
              "bayesian-optimisation",
              "doe-lhs"
            ],
            "default": "sdm-1",
            "description": "'doe-lhs' draws a Latin hypercube from the space alone; 'bayesian-optimisation' supports at most two objectives."
          },
          "noise": {
            "type": "number",
            "minimum": 0,
            "description": "The standard deviation of a repeated measurement of `value`, finite and at least 0. A single objective only."
          },
          "mode": {
            "enum": [
              "weighted",
              "pareto"
            ],
            "default": "weighted",
            "description": "'weighted' sums the objectives signed by their goal; 'pareto' (two objectives or more) proposes along every trade-off."
          }
        },
        "if": {
          "properties": {
            "method": {
              "const": "doe-lhs"
            }
          },
          "required": [
            "method"
          ]
        },
        "else": {
          "properties": {
            "batch": {
              "maximum": 8
            }
          }
        }
      },
      "Parameter": {
        "oneOf": [
          {
            "title": "continuous",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "low",
              "high"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "const": "continuous"
              },
              "low": {
                "type": "number"
              },
              "high": {
                "type": "number"
              },
              "log": {
                "type": "boolean",
                "description": "a log scale; requires low > 0"
              }
            }
          },
          {
            "title": "integer",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "low",
              "high"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "const": "integer"
              },
              "low": {
                "type": "integer"
              },
              "high": {
                "type": "integer"
              }
            }
          },
          {
            "title": "categorical",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "choices"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "const": "categorical"
              },
              "choices": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        ],
        "description": "Unnamed parameters are x1, x2, ... by position; names must be unique. low < high."
      },
      "HistoryRow": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "params",
          "value"
        ],
        "properties": {
          "params": {
            "type": "object",
            "description": "Exactly every parameter of the space, inside its range.",
            "additionalProperties": {
              "type": [
                "number",
                "string"
              ]
            }
          },
          "value": {
            "type": [
              "number",
              "null"
            ],
            "description": "The result, or null for a failed run."
          },
          "values": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "number",
                "null"
              ]
            },
            "description": "With objectives: each objective's reading, null if not read."
          }
        }
      },
      "Objective": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "goal"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "goal": {
            "enum": [
              "maximize",
              "minimize"
            ]
          },
          "reference": {
            "type": "number",
            "description": "pareto only: the worst value still worth having; for all objectives or none"
          }
        }
      },
      "ProposeAnswer": {
        "type": "object",
        "required": [
          "proposals",
          "model",
          "version"
        ],
        "properties": {
          "proposals": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "params"
              ],
              "properties": {
                "params": {
                  "type": "object"
                }
              }
            }
          },
          "model": {
            "type": "string",
            "description": "the method that ran"
          },
          "version": {
            "type": "string",
            "pattern": "^[a-z0-9-]+-[0-9a-f]{12}$",
            "examples": [
              "sdm-1-3f9a0c2b7d41"
            ],
            "description": "an opaque identifier of the served model, the method and a hash; it changes whenever the model changes"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "enum": [
              "invalid_request",
              "unauthorized",
              "forbidden",
              "not_found",
              "rate_limited",
              "quota_exceeded",
              "high_demand",
              "paused"
            ]
          },
          "message": {
            "type": "string"
          },
          "retry_after_s": {
            "type": "number",
            "description": "present when the same call succeeds after an interval; equal to Retry-After"
          },
          "docs": {
            "type": "string",
            "format": "uri",
            "const": "https://provigen.ai/sdm1/api.md"
          }
        }
      },
      "Usage": {
        "oneOf": [
          {
            "title": "trial",
            "type": "object",
            "required": [
              "tier",
              "trial",
              "trial_pool_open_today",
              "per_minute"
            ],
            "properties": {
              "tier": {
                "const": "trial"
              },
              "trial": {
                "type": "object",
                "required": [
                  "used",
                  "limit",
                  "remaining"
                ],
                "properties": {
                  "used": {
                    "type": "integer",
                    "minimum": 0
                  },
