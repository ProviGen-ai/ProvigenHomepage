# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local environment
.env*
.dev.vars*

# deployment and generated files
.vercel
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/

# TypeScript incremental cache
*.tsbuildinfo

# generated before every build (scripts/make-public-files.mjs)
/public/feed.xml
/public/robots.txt
/public/sitemap.xml

# generated before every build (scripts/make-api-doc.mjs), from content/sdm1/api-doc.ts
/public/llms.txt
/public/sdm1/api.md

# copied before every build (scripts/fetch-openapi.mjs): the API's OpenAPI document and Swagger UI's own files.
# content/sdm1/openapi.json is the committed fallback and IS tracked.
/public/sdm1/openapi.json
/public/sdm1/swagger-ui-bundle.js
/public/sdm1/swagger-ui.css
